{
  // Browser-half program (the Web GUI side). A client bundle may only import
  // @deepseek-ai/* type-only (the build-time purity gate enforces the value
  // side); cross-plugin collaboration goes through cordis services.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": []
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/core/**/*.ts",
    "src/css-modules.d.ts"
  ]
}
